// Prisma Schema for OmniFetch Pro Global Settings, SEO Engine & Live Analytics / Download Logs
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

model GlobalSettings {
  id                String   @id @default("default")
  adsenseClientId   String   @default("ca-pub-1234567890000000")
  googleAnalyticsId String   @default("G-XXXXXXXXXX")
  trustpilotUrl     String   @default("https://www.trustpilot.com/review/omnifetchpro.com")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SeoTranslations {
  id              String   @id @default(cuid())
  language        String   // e.g. "en", "ar", "es"
  platform        String   // e.g. "tiktok", "youtube", "instagram"
  h1Title         String
  metaDescription String
  keywords        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([language, platform])
}

model DownloadLog {
  id            String   @id @default(cuid())
  url           String
  title         String
  platform      String
  thumbnail     String?
  quality       String?
  ipAddress     String?
  downloadCount Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([platform])
  @@index([url])
}

model UserAnalytics {
  id        String   @id @default(cuid())
  event     String
  details   String?
  ipAddress String?
  country   String?
  createdAt DateTime @default(now())
}
