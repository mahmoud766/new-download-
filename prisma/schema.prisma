// Prisma Schema for OmniFetch Pro Global Settings, Ad Placements, Platforms, Audit Logs & Analytics
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

model GlobalSettings {
  id                     String   @id @default("default")
  siteName               String   @default("OmniFetch Pro")
  shortName              String   @default("PRO")
  tagline                String?  @default("أفضل وأسرع أداة مجانية لتحميل الفيديوهات بدون علامة مائية")
  siteDescription        String?  @default("أفضل وأسرع أداة مجانية لتحميل فيديوهات تيك توك، يوتيوب شورتس، فيسبوك ريلز وإنستغرام بدقة HD وبدون علامات مائية")
  logoUrl                String?  @default("")
  faviconUrl             String?  @default("")
  contactEmail           String?  @default("support@omnifetchpro.com")
  contactPhone           String?  @default("")
  primaryColor           String?  @default("#9333ea")
  secondaryColor         String?  @default("#3b82f6")
  adsenseClientId        String?  @default("ca-pub-1234567890000000")
  googleAnalyticsId      String?  @default("G-XXXXXXXXXX")
  ga4Id                  String?  @default("G-OMNIFETCH2026")
  gtmId                  String?  @default("GTM-OMNIFETCH")
  fbPixelId              String?  @default("")
  clarityId              String?  @default("")
  trustpilotUrl          String?  @default("https://www.trustpilot.com/review/omnifetchpro.com")
  maintenanceMode        Boolean  @default(false)
  rateLimitPerMinute     Int      @default(60)
  allowMp3Conversion     Boolean  @default(true)
  watermarkFreeByDefault Boolean  @default(true)
  headerStyle            String?  @default("sticky")
  customCss              String?  @default("")
  customJs               String?  @default("")
  socialLinksJson        String?  @default("{}")
  adsConfigJson          String?  @default("[]")
  platformsConfigJson    String?  @default("{}")
  seoConfigJson          String?  @default("{}")
  faqsConfigJson         String?  @default("[]")
  blogsConfigJson        String?  @default("[]")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AdPlacement {
  id           String   @id @default(cuid())
  slotId       String   @unique
  name         String
  type         String   @default("adsense") // "adsense", "html", "script", "banner", "native", "popup", "sticky"
  position     String   @default("header") // "header", "footer", "sidebar", "before_download", "after_download", "between_content"
  enabled      Boolean  @default(true)
  adClient     String?  @default("")
  adSlot       String?  @default("")
  customHtml   String?  @default("")
  deviceTarget String?  @default("all") // "all", "mobile", "desktop"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PlatformSetting {
  id           String   @id @default(cuid())
  slug         String   @unique // "tiktok", "youtube", "facebook", "instagram", etc.
  name         String
  enabled      Boolean  @default(true)
  priority     Int      @default(1)
  apiEndpoint  String?  @default("")
  apiToken     String?  @default("")
  rateLimit    Int      @default(100)
  status       String   @default("HEALTHY") // "HEALTHY", "DEGRADED", "OFFLINE"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userEmail  String   @default("admin@omnifetchpro.com")
  action     String   // e.g. "UPDATE_SETTINGS", "TOGGLE_AD", "UPDATE_PLATFORM"
  details    String
  ipAddress  String?  @default("127.0.0.1")
  createdAt  DateTime @default(now())
}

model SeoTranslations {
  id              String   @id @default(cuid())
  language        String   // e.g. "en", "ar", "es"
  platform        String   // e.g. "tiktok", "youtube", "instagram"
  h1Title         String
  metaDescription String
  keywords        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([language, platform])
}

model DownloadLog {
  id            String   @id @default(cuid())
  url           String
  title         String
  platform      String
  thumbnail     String?
  quality       String?
  ipAddress     String?
  downloadCount Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([platform])
  @@index([url])
}

model UserAnalytics {
  id        String   @id @default(cuid())
  event     String
  details   String?
  ipAddress String?
  country   String?
  createdAt DateTime @default(now())
}
