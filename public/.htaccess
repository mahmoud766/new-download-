# ==============================================================================
# OmniFetch Pro - Hostinger / Apache Security & Production .htaccess Configuration
# Place this file inside public_html or dist/ folder on Hostinger
# ==============================================================================

# Disable Directory Indexing & Browsing
Options -Indexes

# Set Server Timezone & Default UTF-8 Encoding
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. Force HTTPS (SSL Encryption)
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------------------
  # 2. Block Direct Access to Sensitive Files (.env, .git, json configs, logs)
  # ----------------------------------------------------------------------------
  RewriteRule ^\.env - [F,L]
  RewriteRule ^\.git - [F,L]
  RewriteRule ^package(-lock)?\.json$ - [F,L]
  RewriteRule ^tsconfig\.json$ - [F,L]
  RewriteRule \.(log|sh|md|sql|bak|swp)$ - [F,L]

  # ----------------------------------------------------------------------------
  # 3. Handle Single Page Application (SPA) Client Routing
  # Directs all non-file & non-directory requests to index.html
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 4. Security Headers Configuration (OWASP Best Practices)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent Clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Prevent MIME-Type Sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Enable XSS Filter Protection
  Header set X-XSS-Protection "1; mode=block"
  
  # Strict Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Feature / Permissions Policy
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ------------------------------------------------------------------------------
# 5. Leverage Browser Caching for Static Assets (Performance Optimization)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # CSS & JS Bundle Caching (1 year)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  
  # Images & Media Caching
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 6. Gzip Deflate Compression for Faster Load Speeds
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
