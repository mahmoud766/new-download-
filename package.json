{
  "name": "omnifetch-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npx prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "postinstall": "npx prisma generate",
    "lint": "tsc --noEmit",
    "test:security": "node scripts/security-audit.js"
  },
  "dependencies": {
